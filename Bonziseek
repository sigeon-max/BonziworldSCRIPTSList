setTimeout(() => {

    socket.emit("command", {
        list: [
            "name",
            botname
        ]
    });

}, 1000);

// ============================================================
// ONLINE MESSAGE
// ============================================================

setTimeout(() => {

    sendMsg(
        "BonziSeek is online. Type " +
        prefix +
        "help to see commands."
    );

}, 2000);

// ============================================================
// COMMAND HANDLER
// ============================================================

socket.on("talk", async (message) => {

    if (!message || typeof message.text !== "string") {
        return;
    }

    const text = message.text.trim();

    // ========================================================
    // LOCK
    // ========================================================

    if (lockcmd) {
        return;
    }

    // ========================================================
    // HELP
    // ========================================================

    if (text === prefix + "help") {

        return sendMsg(help);
    }

    // ========================================================
    // JOKE / FACT / BACKFLIP
    // ========================================================

    if (text === prefix + "joke") {

        if (typeof cmd === "function") {
            return cmd("joke");
        }

        return sendMsg(
            "Why did the Bonzi cross the desktop? " +
            "To get to the other window!"
        );
    }

    if (text === prefix + "fact") {

        if (typeof cmd === "function") {
            return cmd("fact");
        }

        return sendMsg(
            "BonziSeek uses DeepSeek through OpenRouter."
        );
    }

    if (text === prefix + "backflip") {

        if (typeof cmd === "function") {
            return cmd("backflip");
        }

        return sendMsg(
            "*BonziSeek does a spectacular backflip*"
        );
    }

    // ========================================================
    // ASK
    // ========================================================

    if (text.startsWith(prefix + "ask")) {

        const userQuery =
            text
                .substring(
                    (prefix + "ask").length
                )
                .trim();

        if (!userQuery) {

            return sendMsg(
                "Please provide a question or prompt after '" +
                prefix +
                "ask'."
            );
        }

        // Processing message
        sendMsg(
            "- Processing your query..."
        );

        const aiResponse =
            await queryBonziSeek(userQuery);

        sendMsg(
            "**BonziSeek:** " +
            aiResponse
        );

        uses++;

        return;
    }
});

