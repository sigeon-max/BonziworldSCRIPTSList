// ============================================================
// BONZISEEK AI
// ============================================================

async function queryBonziSeek(inputText) {

    try {

        const response = await fetch(OPENROUTER_URL, {
            method: "POST",

            headers: {
                "Authorization": "Bearer " + OPENROUTER_API_KEY,
                "Content-Type": "application/json",

                "HTTP-Referer":
                    window.location.origin,

                "X-Title":
                    "BonziSeek"
            },

            body: JSON.stringify({

                model: OPENROUTER_MODEL,

                messages: [
                    {
                        role: "system",

                        content:
                            "You are BonziSeek, an AI assistant inside BonziWORLD. " +
                            "Be helpful, friendly, concise and occasionally playful. " +
                            "Your name is BonziSeek. " +
                            "Do not claim to be the original BonziBuddy. " +
                            "Answer the user's question directly."
                    },

                    {
                        role: "user",
                        content: inputText
                    }
                ],

                temperature: 0.8,

                max_tokens: 1200

            })
        });

        const data = await response.json();

        if (!response.ok) {

            console.error(
                "BonziSeek/OpenRouter error:",
                data
            );

            return (
                "BonziSeek error: " +
                (
                    data?.error?.message ||
                    "OpenRouter request failed."
                )
            );
        }

        const result =
            data?.choices?.[0]?.message?.content;

        if (!result) {
            return "BonziSeek couldn't generate a response.";
        }

        return result.trim();

    } catch (error) {

        console.error(
            "BonziSeek connection error:",
            error
        );

        return (
            "BonziSeek couldn't connect to OpenRouter."
        );
    }
}

// ============================================================
// REGISTER BOT NAME
