function modeAwareReply(text) {
    if (botTextMode === "genz") {
        if (isDumbQuestion(text)) {
            return "bradar delete this😭🙏";
        }

        return genzReply(text);
    }

    return text;
}

// ============================================================
// MAIN CHAT HANDLER
// ============================================================

socket.on("talk", (message) => {
    if (!message || typeof message.text !== "string") {
        return;
    }

    const text = message.text;
    const username = getUsername(message);

    // Remember anyone who is visibly active in chat.
    updateActiveUser(username);

    // ========================================================
    // TEXT MODE COMMANDS
    // ========================================================

    if (text === prefix + "modenormal") {
        botTextMode = "normal";
        return sendMsg("Normal mode enabled.");
    }

    if (text === prefix + "modegenz") {
        botTextMode = "genz";
        return sendMsg("bradar modegenz activated 😭🙏🔥");
    }


    // ========================================================
    // EXTRA FUN COMMANDS
    // ========================================================

    if (text === prefix + "wtf") {
        return sendMsg(randomItem(wtfMessages));
    }

    // Rainbow name.
    // The requested "$r$" mechanism becomes "b!r!".
    // "b!rainbowname" is the friendly command that activates it.
    if (text === prefix + "rainbowname") {
        rainbowName();
        return sendMsg("🌈 My name is going RAINBOW!");
    }

    if (text === prefix + "r!") {
        rainbowName();
        return sendMsg("🌈 RAINBOW BONZI!");
    }

    if (text.startsWith(prefix + "fancyecho")) {
        const fancyText =
            text.substring(prefix.length + 9).trim();

        if (!fancyText) {
            return sendMsg("✨ Give me something fancy to say!");
        }

        return sendMsg(fancyEcho(fancyText));
    }

    if (text.startsWith(prefix + "zalgo")) {
        const zalgoText =
            text.substring(prefix.length + 5).trim();

        if (!zalgoText) {
            return sendMsg("👁️ Give me something to corrupt...");
        }

        return sendMsg(makeZalgo(zalgoText));
    }

    if (text.startsWith(prefix + "echo")) {
        const echoText =
            text.substring(prefix.length + 4).trim();

        if (!echoText) {
            return sendMsg("What do you want me to say?");
        }

        return sendMsg(modeAwareReply(echoText));
    }

    // b!say is an alias for b!echo.
    if (text.startsWith(prefix + "say")) {
        const sayText =
            text.substring(prefix.length + 3).trim();

        if (!sayText) {
            return sendMsg("What do you want me to say?");
        }

        return sendMsg(modeAwareReply(sayText));
    }

    if (text.startsWith(prefix + "eccho")) {
        const ecchoText =
            text.substring(prefix.length + 5).trim();

        if (!ecchoText) {
            return sendMsg("What do you want me to say phonetically?");
        }

        return sendMsg(phoneticEcho(ecchoText));
    }

    if (text === prefix + "coinflip") {
        return sendMsg(
            Math.random() < 0.5
                ? "🪙 Heads!"
                : "🪙 Tails!"
        );
    }

    if (text.startsWith(prefix + "rps")) {
        const rpsChoice =
            text.substring(prefix.length + 3).trim();

        if (!rpsChoice) {
            return sendMsg(
                "🎮 Use b!rps rock, b!rps paper, or b!rps scissors!"
            );
        }

        return sendMsg(playRPS(rpsChoice));
    }


    // ========================================================
    // HELP
    // ========================================================

    if (text === prefix + "help") {
        return sendMsg(help);
    }

    // ========================================================
    // SAY
    // ========================================================


    // ========================================================
    // APPLE
    // ========================================================

    if (text === prefix + "aplle") {
        return sendMsg("ew, apple.\n yay, aplle");
    }

    // ========================================================
    // LLAMA
    // ========================================================

    if (text === prefix + "llama") {
        return cmd(
            "img https://files.catbox.moe/qkbzrk.jpeg"
        );
    }

    // ========================================================
    // JOKE / FACT / BACKFLIP / FREEPOPE
    // ========================================================

    if (text === prefix + "joke") return cmd("joke");
    if (text === prefix + "fact") return cmd("fact");
    if (text === prefix + "backflip") return cmd("backflip");
    if (text === prefix + "freepope") return cmd("freepope");

    // ========================================================
    // ASSHOLE
    // ========================================================

    if (text.startsWith(prefix + "asshole")) {
        if (botCannotAsshole === true) {
            sendMsg("disabled")
        }
        if (botCannotAsshole === false) {
            cmd(`asshole ${text.substring(prefix.length + 7)}`);
        }
    }
    
    // ========================================================
    // SOURCE
    // ========================================================

    if (text === prefix + "source") {
        return sendMsg("-moved to " + prefix + "links");
    }

    // ========================================================
    // IMAGES
    // ========================================================

    if (text === prefix + "parrot") {
        return cmd(
            "img https://files.catbox.moe/9xklj5.jpeg"
        );
    }

    if (text === prefix + "cow") {
        return cmd(
            "image https://files.catbox.moe/91ab4p.jpeg"
        );
    }

    if (text === prefix + "giko") {
        return cmd(
            "image https://files.catbox.moe/lgg7qh.png"
        );
    }

    if (text === prefix + "camel") {
        return cmd(
            "image https://files.catbox.moe/yesz9i.png"
        );
    }

    if (text === prefix + "noob") {
        return cmd(
            "image https://files.catbox.moe/npzky7.webp"
        );
    }

    // ========================================================
    // GIBBERISH
    // ========================================================

    if (text.startsWith(prefix + "gibberish")) {
        const gibberishlang = [
            "[[_^_cmn]]", "[[_^_vi]]", "[[_^_en]]",
            "[[_^_es]]", "[[_^_fr]]", "[[_^_de]]",
            "[[_^_it]]", "[[_^_pt]]", "[[_^_ru]]",
            "[[_^_ja]]", "[[_^_ko]]", "[[_^_zh]]"
        ];

        const gibberishmessage = [
            "h@x du da de d3!",
            "tygtyty@",
            "@plle p0i",
            "sal@d@",
            "Hs @e",
            "p03 ere mu",
            "ooer nooer",
            "i?",
            "r0RRRR",
            "b0303er n030303r"
        ];

        return sendMsg(
            randomItem(gibberishlang) +
            " " +
            randomItem(gibberishmessage)
        );
    }

    // ========================================================
    // JOSEPHIFY
    // ========================================================

    if (text === prefix + "josephify") {
        cmd("color yellow");
        cmd("hat tophat");
        cmd("name Emperor Joseph");

        return sendMsg("^^**MY EMPERORS!**^^");
    }

    // ========================================================
    // JZIFY
    // ========================================================

    if (text === prefix + "jzify") {
        cmd("color purple");
        cmd("hat glitch");
        cmd("name jzbot " + prefix + "help");

        return sendMsg(
            "yo, try " +
            prefix +
            "help. or " +
            prefix +
            "source if you want my boy, bot."
        );
    }

    // ========================================================
    // GOKID
    // ========================================================

    if (text.startsWith(prefix + "gokid")) {
        if (lockcmd === true) {
            return sendMsg("disabled");
        }

        const userxd =
            text.substring(prefix.length + 6).trim();

        const gokids = [
            `${userxd}, your a gokid!`,
            `Hey, ${userxd}! You're a freaking gokid!`
        ];

        return sendMsg(randomItem(gokids));
    }

    // ========================================================
    // 8 BALL
    // ========================================================

    if (text.startsWith(prefix + "8ball")) {
        const question =
            text.substring(prefix.length + 5).trim();

        if (!question) {
            return sendMsg(
                "You need to ask a question!"
            );
        }

        return sendMsg(
            "🎱 " +
            randomItem(eightBallResponses)
        );
    }

    // ========================================================
    // MOCK
    // ========================================================

    if (text.startsWith(prefix + "mock")) {
        const mockTarget =
            text.substring(prefix.length + 4).trim();

        if (!mockTarget) {
            return sendMsg(
                "What do you want me to mock?"
            );
        }

        return sendMsg(mockText(mockTarget));
    }

    // ========================================================
    // REVERSE
    // ========================================================

    if (text.startsWith(prefix + "reverse")) {
        const revText =
            text.substring(prefix.length + 7).trim();

        if (!revText) {
            return sendMsg(
                "Provide text to reverse!"
            );
        }

        return sendMsg(
            revText.split("").reverse().join("")
        );
    }

    // ========================================================
    // HUG
    // ========================================================

    if (text.startsWith(prefix + "hug")) {
        const hugTarget =
            text.substring(prefix.length + 3).trim();

        if (!hugTarget) {
            return sendMsg(
                "Who do you want me to hug?"
            );
        }

        return sendMsg(
            `*gives ${hugTarget} a big, warm purple gorilla hug*`
        );
    }

    // ========================================================
    // SLAP
    // ========================================================

    if (text.startsWith(prefix + "slap")) {
        const slapTarget =
            text.substring(prefix.length + 4).trim();

        if (!slapTarget) {
            return sendMsg(
                "Who do you want me to slap?"
            );
        }

        const slapResponses = [
            `*slaps ${slapTarget} with a giant banana*`,
            `*slaps ${slapTarget} across the room*`,
            `*violently slaps ${slapTarget} with a keyboard*`
        ];

        return sendMsg(randomItem(slapResponses));
    }

    // ========================================================
    // BONZI
    // ========================================================

    if (text === prefix + "bonzi") {
        return sendMsg(
            "Hehehehe! BonziBUDDY is here to help you browse the internet! Would you like to install a free cursor?"
        );
    }

    // ========================================================
    // COLOR
    // ========================================================

    if (text.startsWith(prefix + "color")) {
        const newColor =
            text.substring(prefix.length + 5)
                .trim()
                .toLowerCase();

        if (!newColor) {
            return sendMsg(
                "What color should I become?"
            );
        }

        cmd("color " + newColor);

        return sendMsg(
            `Poof! I am now ${newColor}.`
        );
    }

    // ========================================================
    // HAT
    // ========================================================

    if (text.startsWith(prefix + "hat")) {
        const newHat =
            text.substring(prefix.length + 3)
                .trim()
                .toLowerCase();

        if (!newHat) {
            return sendMsg(
                "What hat should I wear?"
            );
        }

        cmd("hat " + newHat);

        return sendMsg(
            `Putting on my ${newHat}!`
        );
    }

    // ========================================================
    // RESET
    // ========================================================

    if (text === prefix + "reset") {
        cmd("color white");
        cmd("hat tophat");
        cmd("name " + botname);

        return sendMsg(
            "Reset back to default BonziBOT!"
        );
    }

    // ========================================================
    // ⚔️ BOSSFIGHT START
    // ========================================================

    if (text === prefix + "bossfight") {
        if (!isBossAdmin(username)) {
            return sendMsg(
                "You need to be an admin to start a bossfight!"
            );
        }

        if (bossFight.active) {
            return sendMsg(
                `⚠️ A bossfight is already happening against ${bossFight.boss.name}!`
            );
        }

        const selectedBoss =
            randomItem(bosses);

        bossFight = {
            active: true,
            boss: selectedBoss,
            bossHP: selectedBoss.maxHP,
            bossMaxHP: selectedBoss.maxHP,
            phase: 1,
            players: {},
            startedBy: username,
            attackTimer: null,
            ending: false
        };

        // Add the admin and every user known to be active.
        Object.keys(activeUsers).forEach(name => {
            addBossPlayer(name);
        });

        addBossPlayer(username);

        bossVFX("bossIntro", {
            boss: selectedBoss.name,
            hp: selectedBoss.maxHP
        });

        bossSFX("boss_intro");

        bossBroadcast("");
        bossBroadcast("━━━━━━━━━━━━━━━━━━━━━━━━");
        bossBroadcast("⚠️⚠️⚠️ **WARNING** ⚠️⚠️⚠️");
        bossBroadcast("");
        bossBroadcast("👹 **A BOSS HAS APPEARED!**");
        bossBroadcast("");
        bossBroadcast(
            `🔥 **${selectedBoss.name}**`
        );
        bossBroadcast(
            `❤️ HP: **${selectedBoss.maxHP}**`
        );
        bossBroadcast(
            `👑 Started by admin **${username}**`
        );
        bossBroadcast("");
        bossBroadcast(
            "🎯 **The boss randomly attacks active users!**"
        );
        bossBroadcast(
            "💥 **Explosive attacks trigger their Bonzi's explode() animation!**"
        );
        bossBroadcast("━━━━━━━━━━━━━━━━━━━━━━━━");

        setTimeout(() => {
            if (!bossFight.active) return;

            bossBroadcast(
                `⚔️ Type **${prefix}attack** to attack!`
            );

            bossBroadcast(
                `💚 Type **${prefix}heal** to heal yourself!`
            );

            bossBroadcast(
                `📊 Type **${prefix}bossstats** for stats!`
            );
        }, 1800);

        bossFight.attackTimer =
            setTimeout(bossTurn, 8000);

        return;
    }

    // ========================================================
    // ⚔️ ATTACK
    // ========================================================

    if (text === prefix + "attack") {
        if (!bossFight.active) {
            return sendMsg(
                "There is no bossfight happening right now."
            );
        }

        const player =
            addBossPlayer(username);

        if (player.hp <= 0) {
            return sendMsg(
                `💀 ${username}, you're defeated and cannot attack!`
            );
        }

        const now = Date.now();

        if (now - player.lastAttack < 1000) {
            return sendMsg(
                "⏳ You're attacking too quickly!"
            );
        }

        player.lastAttack = now;

        let damage =
            randomNumber(200, 500);

        let critical = false;

        if (Math.random() < 0.15) {
            critical = true;
            damage *= 2;
        }

        if (Math.random() < 0.08) {
            bossBroadcast(
                `💨 **${username}** attacked **${bossFight.boss.name}** but MISSED!`
            );

            bossVFX("playerMiss", {
                player: username
            });

            bossSFX("miss");

            return;
        }

        bossFight.bossHP =
            Math.max(
                0,
                bossFight.bossHP - damage
            );

        if (critical) {
            bossBroadcast(
                `💥 **CRITICAL HIT!** **${username}** dealt **${damage} damage!**`
            );

            bossVFX("criticalHit", {
                player: username,
                boss: bossFight.boss.name,
                damage: damage
            });

            bossSFX("critical");
        } else {
            bossBroadcast(
                `⚔️ **${username}** attacked **${bossFight.boss.name}** for **${damage} damage!**`
            );

            bossVFX("playerAttack", {
                player: username,
                boss: bossFight.boss.name,
                damage: damage
            });

            bossSFX("attack");
        }

        bossBroadcast(
            `👹 ${bossFight.boss.name}: **${bossFight.bossHP}/${bossFight.bossMaxHP} HP**`
        );

        bossPhaseCheck();

        if (bossFight.bossHP <= 0) {
            setTimeout(() => {
                endBossFight(true);
            }, 1200);

            return;
        }

        return;
    }

    // ========================================================
    // 💚 HEAL
    // ========================================================

    if (text === prefix + "heal") {
        if (!bossFight.active) {
            return sendMsg(
                "There is no bossfight happening right now."
            );
        }

        const player =
            addBossPlayer(username);

        if (player.hp <= 0) {
            return sendMsg(
                `💀 ${username}, you're defeated!`
            );
        }

        if (player.heals <= 0) {
            return sendMsg(
                `❌ ${username}, you have no heals left!`
            );
        }

        const now = Date.now();

        if (now - player.lastHeal < 5000) {
            return sendMsg(
                "⏳ Your heal is on cooldown!"
            );
        }

        player.lastHeal = now;
        player.heals--;

        const healAmount =
            randomNumber(20, 45);

        const oldHP =
            player.hp;

        player.hp =
            Math.min(
                player.maxHP,
                player.hp + healAmount
            );

        const actualHeal =
            player.hp - oldHP;

        bossBroadcast(
            `💚 **${username}** healed for **${actualHeal} HP!**`
        );

        bossBroadcast(
            `❤️ ${username}: **${player.hp}/${player.maxHP} HP**`
        );

        bossVFX("heal", {
            player: username,
            amount: actualHeal
        });

        bossSFX("heal");

        return;
    }

    // ========================================================
    // 📊 BOSS STATS
    // ========================================================

    if (text === prefix + "bossstats") {
        if (!bossFight.active) {
            return sendMsg(
                "There is no bossfight happening right now."
            );
        }

        const player =
            addBossPlayer(username);

        const percentage =
            Math.floor(
                (bossFight.bossHP /
                    bossFight.bossMaxHP) *
                100
            );

        bossBroadcast("━━━━━━━━━━━━━━━━━━━━━━━━");

        bossBroadcast(
            `👹 **${bossFight.boss.name}**`
        );

        bossBroadcast(
            `❤️ Boss HP: **${bossFight.bossHP}/${bossFight.bossMaxHP} (${percentage}%)**`
        );

        bossBroadcast(
            `🔥 Phase: **${bossFight.phase}**`
        );

        bossBroadcast(
            `👥 Players: **${bossPlayerCount()}**`
        );

        bossBroadcast(
            `🎯 Active users tracked: **${Object.keys(activeUsers).length}**`
        );

        bossBroadcast(
            `❤️ Your HP: **${player.hp}/${player.maxHP}**`
        );

        bossBroadcast(
            `💚 Heals: **${player.heals}**`
        );

        bossBroadcast("━━━━━━━━━━━━━━━━━━━━━━━━");

        return;
    }
});

