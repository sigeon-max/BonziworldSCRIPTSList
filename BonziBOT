function makeZalgo(str) {
    return str.split("").map(char => {
        if (char === " ") return char;

        let result = char;
        const count = randomNumber(2, 6);

        for (let i = 0; i < count; i++) {
            result += randomItem(zalgoChars);
        }

        return result;
    }).join("");
}

function fancyEcho(str) {
    return "✨ 𝓕𝓪𝓷𝓬𝔂 𝓑𝓸𝓷𝔃𝓲: ✨ " + str + " ✨";
}

function phoneticEcho(str) {
    const phonetics = {
        a: "ah",
        b: "bee",
        c: "see",
        d: "dee",
        e: "ee",
        f: "eff",
        g: "gee",
        h: "aitch",
        i: "eye",
        j: "jay",
        k: "kay",
        l: "el",
        m: "em",
        n: "en",
        o: "oh",
        p: "pee",
        q: "cue",
        r: "are",
        s: "ess",
        t: "tee",
        u: "you",
        v: "vee",
        w: "double-you",
        x: "ex",
        y: "why",
        z: "zee"
    };

    return str.split("").map(char => {
        const lower = char.toLowerCase();

        if (phonetics[lower]) {
            const word = phonetics[lower];

            return char === char.toUpperCase()
                ? word.toUpperCase()
                : word;
        }

        return char;
    }).join(" ");
}

const rainbowColors = [
    "red",
    "orange",
    "yellow",
    "green",
    "blue",
    "purple"
];

function rainbowName() {
    // BonziWORLD's color command is used repeatedly to create
    // the rainbow effect while keeping the bot name unchanged.
    let index = 0;

    const interval = setInterval(() => {
        if (index >= rainbowColors.length) {
            clearInterval(interval);
            return;
        }

        cmd("color " + rainbowColors[index]);
        index++;
    }, 450);

    cmd("name " + botname);
}

function playRPS(choice) {
    const normalized = choice.toLowerCase().trim();

    const choices = [
        "rock",
        "paper",
        "scissors"
    ];

    if (!choices.includes(normalized)) {
        return "Use: b!rps rock, b!rps paper, or b!rps scissors";
    }

    const botChoice = randomItem(choices);

    if (normalized === botChoice) {
        return `✊ You chose **${normalized}**. I chose **${botChoice}**. It's a tie!`;
    }

    const playerWins =
        (normalized === "rock" && botChoice === "scissors") ||
        (normalized === "paper" && botChoice === "rock") ||
        (normalized === "scissors" && botChoice === "paper");

    if (playerWins) {
        return `🎮 You chose **${normalized}**. I chose **${botChoice}**. You win!`;
    }

    return `🎮 You chose **${normalized}**. I chose **${botChoice}**. I win!`;
}


