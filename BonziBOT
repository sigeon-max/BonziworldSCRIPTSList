function getRandomActiveUser() {
    cleanupActiveUsers();

    const names = Object.keys(activeUsers);

    if (names.length === 0) {
        return null;
    }

    return randomItem(names);
}

function getRandomActiveBossTarget() {
    // Prefer every currently known active user.
    const username = getRandomActiveUser();

    if (!username) {
        return null;
    }

    addBossPlayer(username);
    return username;
}

// ============================================================
// BOSS PHASE SYSTEM
// ============================================================

function bossPhaseCheck() {
    if (!bossFight.active) return;

    const percentage =
        bossFight.bossHP / bossFight.bossMaxHP;

    let newPhase = 1;

    if (percentage <= 0.75) newPhase = 2;
    if (percentage <= 0.50) newPhase = 3;
    if (percentage <= 0.25) newPhase = 4;

    if (newPhase > bossFight.phase) {
        bossFight.phase = newPhase;

        bossBroadcast(
            `⚠️ **${bossFight.boss.name} HAS ENTERED PHASE ${newPhase}!**`
        );

        bossBroadcast(
            "🔥 The boss is becoming more powerful!"
        );

        bossVFX("phaseChange", {
            boss: bossFight.boss.name,
            phase: newPhase
        });

        bossSFX("phase_change");
    }
}

