// ============================================================
// BOSS AI
// ============================================================

function bossTurn() {
    if (!bossFight.active || bossFight.ending) return;

    // IMPORTANT:
    // The boss now chooses from active users in the room,
    // not only people who typed b!attack.
    const targetName = getRandomActiveBossTarget();

    if (!targetName) {
        bossBroadcast(
            "⚠️ The boss tried to attack, but no active users were found."
        );

        bossFight.attackTimer = setTimeout(bossTurn, 4000);
        return;
    }

    const target = bossFight.players[targetName];

    let attack;

    let specialChance = 0.20;

    if (bossFight.phase >= 3) specialChance = 0.30;
    if (bossFight.phase >= 4) specialChance = 0.40;

    if (Math.random() < specialChance) {
        attack = bossFight.boss.special;
    } else {
        attack = randomItem(bossFight.boss.attacks);
    }

    let damage = randomNumber(
        attack.damageMin,
        attack.damageMax
    );

    damage = Math.floor(
        damage * (1 + ((bossFight.phase - 1) * 0.20))
    );

    // 10% dodge.
    if (Math.random() < 0.10) {
        bossBroadcast(
            `💨 **${targetName} dodged ${attack.name}!**`
        );

        bossVFX("dodge", {
            target: targetName,
            attack: attack.name
        });

        bossSFX("dodge");

        bossFight.attackTimer = setTimeout(
            bossTurn,
            bossFight.phase >= 3 ? 2200 : 3200
        );

        return;
    }

    target.hp = Math.max(
        0,
        target.hp - damage
    );

    bossBroadcast(
        `👹 **${bossFight.boss.name}** used **${attack.name}** on **${targetName}**!`
    );

    bossBroadcast(
        `💥 **${damage} damage!**`
    );

    bossBroadcast(
        `❤️ ${targetName}: **${target.hp}/${target.maxHP} HP**`
    );

    bossVFX(attack.effect, {
        boss: bossFight.boss.name,
        target: targetName,
        damage: damage,
        phase: bossFight.phase
    });

    bossSFX(attack.sound);

    // ========================================================
    // ACTUAL BONZI EXPLOSION
    // ========================================================

    // Explosive attacks trigger the target's existing
    // client-side explode() method.
    if (attack.explode) {
        setTimeout(() => {
            socket.emit("bossfight:explode", {
                target: targetName,
                boss: bossFight.boss.name,
                attack: attack.name,
                damage: damage
            });
        }, 350);
    }

    if (target.hp <= 0) {
        bossBroadcast(
            `💀 **${targetName} has been defeated!**`
        );

        bossVFX("playerDeath", {
            target: targetName
        });

        bossSFX("player_defeat");

        // Defeat animation is also an explosion.
        setTimeout(() => {
            socket.emit("bossfight:explode", {
                target: targetName,
                boss: bossFight.boss.name,
                attack: attack.name,
                defeated: true
            });
        }, 650);
    }

    // Do NOT end the fight just because a player was defeated.
    // Other active users can still be targeted.
    bossFight.attackTimer = setTimeout(
        bossTurn,
        bossFight.phase >= 3 ? 2200 : 3200
    );
}

