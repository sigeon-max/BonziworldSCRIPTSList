function addBossPlayer(username) {
    if (!username || username === "Unknown User") return null;

    if (!bossFight.players[username]) {
        bossFight.players[username] = {
            hp: 100,
            maxHP: 100,
            heals: 3,
            lastAttack: 0,
            lastHeal: 0
        };
    }

    return bossFight.players[username];
}

function bossPlayerCount() {
    return Object.keys(bossFight.players).length;
}

function getAlivePlayers() {
    return Object.keys(bossFight.players).filter(
        username => bossFight.players[username].hp > 0
    );
}

function getRandomAlivePlayer() {
    const players = getAlivePlayers();

    if (players.length === 0) return null;

    return randomItem(players);
}

function allPlayersDead() {
    const players = Object.values(bossFight.players);

    if (players.length === 0) return false;

    return players.every(player => player.hp <= 0);
}

