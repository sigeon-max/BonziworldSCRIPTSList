// ============================================================
// GENERAL HELPERS
// ============================================================

function randomNumber(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function randomItem(array) {
    return array[Math.floor(Math.random() * array.length)];
}

function mockText(str) {
    return str
        .split("")
        .map((char, i) =>
            i % 2 === 0 ? char.toLowerCase() : char.toUpperCase()
        )
        .join("");
}

function getUsername(message) {
    return (
        message.name ||
        message.username ||
        message.user ||
        message.userName ||
        message.nick ||
        "Unknown User"
    );
}

function isBossAdmin(username) {
    return bossAdmins.includes(username);
}

function sendMsg(msg) {
    setTimeout(() => {
        socket.emit("talk", { text: msg });
    }, 1100);
}

function updateActiveUser(username) {
    if (!username || username === "Unknown User") return;

    activeUsers[username] = {
        username: username,
        lastSeen: Date.now()
    };

    // Anyone who speaks during a bossfight becomes a player.
    if (bossFight.active) {
        addBossPlayer(username);
    }
}

function cleanupActiveUsers() {
    const now = Date.now();
    const timeout = 10 * 60 * 1000;

    Object.keys(activeUsers).forEach(username => {
        if (now - activeUsers[username].lastSeen > timeout) {
            delete activeUsers[username];
        }
    });
}

