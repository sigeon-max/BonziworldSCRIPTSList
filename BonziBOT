// ============================================================
// CLIENT: TARGETED BONZI EXPLOSION
// ============================================================
//
// This uses the EXISTING explode() method.
//
// It supports:
//   1. bonzis array
//   2. bonzis object
//   3. users array
//   4. users object
//
// Adjust the lookup section if your BonziWORLD client uses
// another collection name.
//

socket.on("bossfight:explode", function(data) {
    if (!data || !data.target) {
        return;
    }

    console.log(
        "[Bossfight] EXPLOSION TARGET:",
        data.target,
        data
    );

    let target = null;

    // --------------------------------------------------------
    // Find target in bonzis[]
    // --------------------------------------------------------

    if (
        typeof bonzis !== "undefined" &&
        Array.isArray(bonzis)
    ) {
        target = bonzis.find(bonzi => {
            return (
                bonzi &&
                (
                    bonzi.name === data.target ||
                    bonzi.username === data.target ||
                    bonzi.nick === data.target ||
                    bonzi.user === data.target
                )
            );
        });
    }

    // --------------------------------------------------------
    // Find target in bonzis{}
    // --------------------------------------------------------

    if (
        !target &&
        typeof bonzis !== "undefined" &&
        bonzis &&
        typeof bonzis === "object" &&
        !Array.isArray(bonzis)
    ) {
        target =
            bonzis[data.target] ||
            Object.values(bonzis).find(bonzi => {
                return (
                    bonzi &&
                    (
                        bonzi.name === data.target ||
                        bonzi.username === data.target ||
                        bonzi.nick === data.target ||
                        bonzi.user === data.target
                    )
                );
            });
    }

    // --------------------------------------------------------
    // Optional users[] fallback
    // --------------------------------------------------------

    if (
        !target &&
        typeof users !== "undefined" &&
        Array.isArray(users)
    ) {
        target = users.find(user => {
            return (
                user &&
                (
                    user.name === data.target ||
                    user.username === data.target ||
                    user.nick === data.target ||
                    user.user === data.target
                )
            );
        });
    }

    // --------------------------------------------------------
    // Optional users{} fallback
    // --------------------------------------------------------

    if (
        !target &&
        typeof users !== "undefined" &&
        users &&
        typeof users === "object" &&
        !Array.isArray(users)
    ) {
        target =
            users[data.target] ||
            Object.values(users).find(user => {
                return (
                    user &&
                    (
                        user.name === data.target ||
                        user.username === data.target ||
                        user.nick === data.target ||
                        user.user === data.target
                    )
                );
            });
    }

    if (!target) {
        console.warn(
            "[Bossfight] Could not find Bonzi:",
            data.target
        );
        return;
    }

    // --------------------------------------------------------
    // CALL THE EXISTING explode() METHOD
    // --------------------------------------------------------

    if (typeof target.explode === "function") {
        target.explode();
        return;
    }

    console.warn(
        "[Bossfight] Target exists but has no explode():",
        data.target
    );
});

